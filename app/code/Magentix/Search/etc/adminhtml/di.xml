<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Rebuild the dictionary after "Flush Magento Cache" and "Flush Cache Storage" (Cache Management) -->
    <type name="Magento\Backend\Controller\Adminhtml\Cache\FlushSystem">
        <plugin name="magentix_search_refresh_dictionary" type="Magentix\Search\Plugin\RefreshDictionary"/>
    </type>
    <type name="Magento\Backend\Controller\Adminhtml\Cache\FlushAll">
        <plugin name="magentix_search_refresh_dictionary" type="Magentix\Search\Plugin\RefreshDictionary"/>
    </type>
</config>
